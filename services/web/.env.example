# Copy to .env for local runs outside Docker Compose.
COORDINATOR_URL=http://localhost:8001
COOKIE_SECURE=false

# S3 (MinIO locally). AWS credentials come from the usual AWS_* variables.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=csc3104-local
# Same value as the Lambda's HMAC_SECRET. Leave empty to turn /hooks/pages-ready off.
HMAC_SECRET=
# true = render PDF pages in the web app (no Lambda), for local development only
LOCAL_RENDER=true
