# Copy to .env.aws and fill in. Paths are relative to the repo root.
# Keep each comment on its own line.
AWS_REGION=us-east-1
BURST_INSTANCE_TYPE=t3.small
BURST_MAX_LIFETIME_MIN=120
# Ask member 1 to run: k3s --version
K3S_VERSION=
# Optional. Read the slot config and token from files instead of K8s Secrets.
# BURST_WG_DIR=runtime/wg-slots
# K3S_TOKEN_FILE=runtime/wg-slots/k3s.token
