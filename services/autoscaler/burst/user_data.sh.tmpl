#!/bin/bash
# Burst worker bootstrap for Campus Idle-Compute Cloud.
# Rendered per slot by burst/user_data.py. Do not run this file by hand.
set -euo pipefail
exec > >(tee -a /var/log/idlecloud-burst.log) 2>&1

SLOT="{{SLOT}}"
NODE_IP="{{NODE_IP}}"
NODE_NAME="{{NODE_NAME}}"

# Safety net. The launch template sets shutdown behaviour to terminate,
# so this ends the instance even if the autoscaler is down.
shutdown -h +{{MAX_LIFETIME_MIN}} "idlecloud burst lifetime reached" || true

# If any step fails, keep the instance 10 minutes so you can read the log, then terminate
trap 'echo "BOOTSTRAP FAILED, terminating in 10 minutes"; shutdown -h +10' ERR

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y wireguard-tools

# ---- graceful node shutdown ----
# On power-off the kubelet first stops task pods, then critical pods (the Spot
# watcher), using a logind delay lock. Both periods are upper limits.
install -d -m 755 /etc/idlecloud/kubelet.conf.d
cat > /etc/idlecloud/kubelet.conf.d/50-graceful-shutdown.conf <<'KUBELETEOF'
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
shutdownGracePeriod: {{SHUTDOWN_GRACE_S}}s
shutdownGracePeriodCriticalPods: {{CRITICAL_GRACE_S}}s
KUBELETEOF

# Ubuntu's unattended-upgrades caps logind's delay at 30 s in
# /usr/lib/systemd/logind.conf.d/unattended-upgrades-logind-maxdelay.conf, and
# that file is read after the kubelet's own 99-kubelet.conf. A file with the
# same name in /etc replaces it. The package itself stays.
install -d -m 755 /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/unattended-upgrades-logind-maxdelay.conf <<'LOGINDEOF'
[Login]
InhibitDelayMaxSec={{LOGIND_DELAY_MAX_S}}
LOGINDEOF

# --- shutdown checks (begin) ---
# Every probe has its own time limit, and every wait a real deadline, so a slow
# or hung busctl or systemd-inhibit cannot stretch a wait.
probe() {
  timeout -k 1 3 "$@"
}

# logind's live limit in whole seconds, 0 if it cannot be read
logind_delay_s() {
  local raw
  raw=$(probe busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
    org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null || true)
  case "$raw" in
    "t "[0-9]*) echo $(( ${raw#t } / 1000000 )) ;;
    *) echo 0 ;;
  esac
}

# Whether the kubelet holds its shutdown lock in delay mode. Columns:
# WHO UID USER PID COMM WHAT WHY... MODE (WHY may contain spaces)
kubelet_holds_delay_lock() {
  probe systemd-inhibit --list --no-pager --no-legend 2>/dev/null |
    awk '$1 == "kubelet" && $6 ~ /(^|:)shutdown(:|$)/ && $NF == "delay" { found = 1 }
         END { exit !found }'
}

# Until $1 seconds have passed: wait for logind's live limit to reach $2 seconds
wait_for_logind_delay() {
  local deadline=$((SECONDS + $1))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if [ "$(logind_delay_s)" -ge "$2" ]; then
      return 0
    fi
    sleep 1
  done
  return 1
}

# Until $1 seconds have passed: wait for the live limit and the kubelet's lock
wait_for_graceful_shutdown() {
  local deadline=$((SECONDS + $1))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if [ "$(logind_delay_s)" -ge {{SHUTDOWN_GRACE_S}} ] && kubelet_holds_delay_lock; then
      return 0
    fi
    sleep 2
  done
  return 1
}
# --- shutdown checks (end) ---

# Apply the new limit now, before K3s starts, and confirm the live value
systemctl kill -s HUP systemd-logind || true
if wait_for_logind_delay 15 {{SHUTDOWN_GRACE_S}}; then
  echo "logind delay limit is $(logind_delay_s) s"
else
  echo "WARNING: logind delay limit is $(logind_delay_s) s, below {{SHUTDOWN_GRACE_S}} s"
fi

install -d -m 700 /etc/wireguard
cat > /etc/wireguard/wg0.conf <<'WGEOF'
{{WG_CONF}}
WGEOF
chmod 600 /etc/wireguard/wg0.conf
systemctl enable --now wg-quick@wg0

# Wait for the hub to answer through the tunnel before joining
for attempt in $(seq 1 30); do
  if ping -c1 -W2 {{HUB_WG_IP}} >/dev/null 2>&1; then
    break
  fi
  sleep 2
done
if ! ping -c1 -W2 {{HUB_WG_IP}} >/dev/null 2>&1; then
  echo "WireGuard tunnel never came up. BOOTSTRAP FAILED, terminating in 10 minutes"
  shutdown -h +10
  exit 1
fi

# The node labels itself with its own instance id, so the autoscaler can tell
# which machine a node and its reclaim warning belong to (IMDSv2)
IMDS_TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
INSTANCE_ID=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id)
: "${INSTANCE_ID:?no instance id from instance metadata}"

curl -sfL https://get.k3s.io | \
  INSTALL_K3S_VERSION='{{K3S_VERSION}}' K3S_URL='{{K3S_URL}}' K3S_TOKEN='{{K3S_TOKEN}}' \
  sh -s - agent \
    --node-name "$NODE_NAME" \
    --node-ip "$NODE_IP" \
    --flannel-iface wg0 \
    --node-label idlecloud/role=worker \
    --node-label idlecloud/pool=cloud \
    --node-label idlecloud/trust=high \
    --node-label "idlecloud/burst-slot=$SLOT" \
    --node-label "idlecloud/instance-type={{INSTANCE_TYPE}}" \
    --node-label "idlecloud/instance-id=$INSTANCE_ID" \
    --kubelet-arg "config-dir=/etc/idlecloud/kubelet.conf.d"

echo "burst worker $NODE_NAME joined"

# Graceful shutdown only works if the kubelet's shutdown manager started. It
# fails to start when logind's limit stays too low. The worker still runs
# either way, so this only reports.
if wait_for_graceful_shutdown 90; then
  echo "graceful shutdown check: PASS (logind limit $(logind_delay_s) s, kubelet delay lock held)"
else
  echo "graceful shutdown check: FAIL (logind limit $(logind_delay_s) s). Inhibitor locks:"
  probe systemd-inhibit --list --no-pager || true
fi
